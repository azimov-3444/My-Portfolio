{
  "name": "fullstack-developer-portfolio",
  "version": "1.0.0",
  "description": "Professional Full-Stack Developer Portfolio and Telegram Bot System",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm --prefix server run dev",
    "dev:server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "portfolio",
    "react",
    "nodejs",
    "express",
    "telegram-bot",
    "fullstack",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-telegram-bot-api": "^0.66.0"
  }
}
